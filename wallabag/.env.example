# .env - Environment Variables
#
# Public template. Every value here is a placeholder and real values must never be committed.
# Copy this file to .env on the host, fill it in there, and keep .env out of git.

# Host port the web UI is published on.
PORT=8280

# Host LAN address the published port binds to. Use this host's single LAN address.
# 0.0.0.0 must never be used: it would bypass Caddy and expose Wallabag on every interface.
BIND_ADDR=192.0.2.20

DBUSER=wallabag

# Database password. Generate it with: openssl rand -hex 32
DBPASS=changeme!

FROM_EMAIL=email@domain.tld
DOMAINNAME=https://wallabag.domain.tld
SITE_TITLE='My Wallabag Instance'
DATADIR='./APPDATA/'

# MariaDB root password. Generate it with: openssl rand -hex 32
MYSQL_ROOT_PASSWD=changeme!
