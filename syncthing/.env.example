# .env - Environment Variables for Syncthing
#
# Public template. No secret is stored here, but the addresses are host-specific: copy this
# file to .env on the host and edit it there. .env is gitignored.

# This host's address on the LAN. The web UI (8384) binds to it so Caddy on server1 can
# proxy it; server2's nftables rules accept that port from server1 only. Never use 0.0.0.0.
BIND_ADDR=192.0.2.20

# This host's tailnet address. Sync ports 22000/tcp, 22000/udp and 21027/udp bind to it, so
# sync traffic is reachable from tailnet members and from nowhere else.
# Placeholder: replace with the address Tailscale assigns to this host (100.64.0.0/10).
TAILSCALE_ADDR=100.64.0.10
