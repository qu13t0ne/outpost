# .env - Environment Variables

# GENERAL
PORT=8180

# Host LAN address the published port binds to. Use this host's single LAN address.
# 0.0.0.0 must never be used: it would bypass Caddy and expose Nextcloud on every interface.
BIND_ADDR=192.0.2.20

# APACHE_IP_BINDING for the AIO apache container. Set it to the same address as BIND_ADDR.
HOST_IP=changeme

# Allows to set the host directory for Nextcloud's datadir. ⚠️⚠️⚠️ Warning: do not set or adjust this value after the initial Nextcloud installation is done! See https://github.com/nextcloud/all-in-one#how-to-change-the-default-location-of-nextclouds-datadir
DATADIR=/srv/ncdata
