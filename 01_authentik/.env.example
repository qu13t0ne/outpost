# .env - Environment Variables for Authentik
#
# Public template. Every value below is a placeholder: replace it before starting the stack.
# Real values must never be committed. docker-compose.yml marks the database password and the
# secret key as required, so `docker compose config` fails until both are set.

# Host directory that holds Authentik media, certificates and custom templates.
CONFIG_PATH="./conf/"

# Container timezone.
TZ=UTC

# PostgreSQL database name used by Authentik.
PG_DB=authentik

# PostgreSQL user used by Authentik.
PG_USER=authentik

# PostgreSQL password. Generate it with: openssl rand -hex 32
PG_PASS=changeme!

# Application secret key. Generate it with: openssl rand -hex 32
# Authentik derives session and signing material from it, so it must be unique per deployment.
AUTHENTIK_SECRET_KEY=changeme!

# Authentik server image.
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server

# Authentik image tag. Pinned on purpose: upgrade deliberately, then test the login flow.
AUTHENTIK_TAG=2025.8.1

# Host port for the HTTP listener. Published on 127.0.0.1 only, so it is reachable just by Caddy.
COMPOSE_PORT_HTTP=9000

# Host port for the HTTPS listener. Published on 127.0.0.1 only, for the same reason.
COMPOSE_PORT_HTTPS=9443
