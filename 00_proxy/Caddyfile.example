# ===== GLOBAL OPTIONS BLOCK ==============================
{
	# ----- General Options -------------------------------
	# debug is for troubleshooting only and must not be left on. It is global: it would
	# log request headers and bodies for every site, including cookies and tokens.
	# debug

	# ----- TLS Settings ----------------------------------
	email {$EMAIL_FOR_ACME}
	# STAGING ONLY. The Let's Encrypt staging CA issues untrusted certificates. Uncomment
	# this line only while testing ACME, then comment it again for production.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
	# local_certs # issue internal certs (for local / dev environments)

	# ----- Client IP and trusted proxies -----------------
	servers {
		# Only the Cloudflare tunnel container is trusted to state the client IP. Header
		# values from every other peer, LAN clients included, are ignored, so a LAN client
		# cannot spoof CF-Connecting-IP and appear to arrive from Cloudflare.
		#
		# Replace the range below with the Docker network range that holds the cloudflared
		# container. Confirm it on the proxy host with:
		#   docker network inspect outpost --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
		trusted_proxies static 172.30.0.0/24

		# Take the client IP from this header, but only when the peer is trusted above.
		client_ip_headers CF-Connecting-IP
	}
}

# ===== SNIPPETS ==========================================

(use_tls) {
	tls {
		dns cloudflare {$CF_API_TOKEN}
		resolvers 1.1.1.1
	}
}

(errorHandling) {
	handle_errors {
		root * /static/

		# Custom page for 403 Forbidden
		@403 {
			expression {http.error.status_code} == 403
		}
		rewrite @403 /403.html
		file_server

		# Custom page for 404 Not Found
		@404 {
			expression {http.error.status_code} == 404
		}
		rewrite @404 /404.html
		file_server

		# Custom page for 500 Internal Server Error
		@500 {
			expression {http.error.status_code} == 500
		}
		rewrite @500 /500.html
		file_server

		# Custom page for any other 4xx or 5xx errors
		@4xx5xx {
			expression {http.error.status_code} >= 400 && {http.error.status_code} <600
		}
		rewrite @4xx5xx /error.html
		file_server
	}
}

(serveStatic200) {
	root * /static/

	import use_tls
	import errorHandling

	rewrite * /200.html
	file_server
}

# ===== SITE BLOCKS =======================================
#
# Two patterns are in use. Pick one per hostname and keep them separate.
#
#   Pattern A - VPN/LAN-only site (the default)
#     The hostname is reachable on the tailnet or the user LAN only, through Caddy on port
#     443. The tunnel has no ingress route to it, so no public path exists. This is the
#     pattern for every VPN-tier service in docs/exposure-model.md: Authentik, Dashy,
#     Immich app, Nextcloud, Syncthing and Wallabag.
#
#   Pattern B - tunnel-exposed site (public, exceptional)
#     The Cloudflare tunnel ingress rules route the hostname to this Caddy, so it is
#     reachable from the internet. Every Pattern B hostname needs a gate: a Cloudflare
#     Access policy on the tunnel, or application-native authentication that survives
#     public exposure.
#
# The public allowlist is enforced in two places: the tunnel's ingress rules in the
# Cloudflare dashboard, and the site blocks here. Adding a hostname in only one of them
# either exposes nothing or points the tunnel at a block that does not exist. Change both
# or neither.
#
# There is no "local only" snippet any more. Reachability is decided by which networks can
# reach Caddy and by trusted_proxies above, not by a remote_ip test inside a site block.

# ----- Initial Caddy Testing -----------------------------

{$DOMAIN} {
	tls internal	# use for stage 1 testing with internal Caddy cert
	# import use_tls	# use for stage 2 testing to get external legit certs
	import errorHandling
	import serveStatic200
}

# ----- Pattern A: VPN/LAN-only site (default) ------------
#
# One block per service. The hostname is not routed by the tunnel; Caddy reaches the app
# host on the LAN and serves the result on 443.

# dashy.{$DOMAIN} {
# 	import use_tls
# 	import errorHandling
#
# 	reverse_proxy <app-host>:<port>
# }

# ----- Pattern B: tunnel-exposed site (public) -----------
#
# Only hostnames listed in the tunnel ingress rules may use this shape, and only with a
# Cloudflare Access policy in front of them. The Immich share surface is the one current
# example; see docs/exposure-model.md.

# share.{$DOMAIN} {
# 	import use_tls
# 	import errorHandling
#
# 	reverse_proxy <app-host>:<port>
# }

# ----- Main  -----------------------------
