# .env file

# BASIC CONFIG
APPDATA=./APPDATA/

# Host LAN address Caddy binds to. Use this host's single LAN address, not 0.0.0.0:
# Caddy is the only ingress from the user LAN and must not listen on every interface.
BIND_ADDR=192.192.192.192 CHANGEME!

# Tailscale tailnet address Caddy binds to
TAILSCALE_ADDR=100.100.100.100 CHANGEME!

# ROUTING & TLS CONFIG
EMAIL_FOR_ACME=email@domain.tld
## Add Cloudflare API token below. Scope = 'All zones - Zone:Read, DNS:Edit'
CF_API_TOKEN=changeme!
## Cloudflared Tunnel Token
TUNNEL_TOKEN=changeme!

# CADDY SECURITY CONFIG
## Create a JWT_SHARED_TOKEN using a random alphanumeric string generator such as https://www.grc.com/passwords.htm
JWT_SHARED_TOKEN=qwertyuiopasdfghjklzxcvbnmCHANGEME
