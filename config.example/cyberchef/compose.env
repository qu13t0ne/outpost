# config.example/cyberchef/compose.env - cyberchef's interpolation values.
#
# BIND_ADDR is a shared per-host fact, so it lives once in outpost.env and is not repeated
# here. The two values cyberchef's compose file interpolates that are its own are below.

# Container name.
CONTAINER_NAME=cyberchef

# Host port the web UI is published on, mapped to the container's 8000.
PORT=8000
