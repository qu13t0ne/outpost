# config.example/00_proxy/compose.env - 00_proxy's interpolation values.
#
# 00_proxy's compose file reads the shared per-host facts from outpost.env (BIND_ADDR on the
# published ports, TAILSCALE_ADDR on the tailnet listener, APPDATA under caddy's data and
# config mounts), so those are not repeated here. What this file adds is the one value the
# compose YAML itself interpolates: the tunnel token.
#
# TUNNEL_TOKEN lives here, not in app.env, because it is used as
#     command: tunnel --no-autoupdate run --token $TUNNEL_TOKEN
# and docker compose interpolates that string while it parses the YAML, from this pool only.
# A value in a container's env_file is NOT available for ${VAR}/$VAR interpolation, so the
# token would expand to an empty string and the tunnel would start without it.
#
# Everything a container reads at run time through `env_file:` - the Caddyfile's
# {$EMAIL_FOR_ACME}, {$CF_API_TOKEN} and {$DOMAIN} - lives in the sibling app.env.

# Cloudflare Tunnel token, copied from the tunnel's "Run" command (the full token is not
# shown in the UI). Placed into the tunnel command by compose interpolation at start time.
TUNNEL_TOKEN=changeme!
