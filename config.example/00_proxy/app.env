# config.example/00_proxy/app.env - application config and tokens the containers read.
#
# Handed to the caddy container via:
#     env_file: ${OUTPOST_CONFIG_DIR}/00_proxy/app.env
# so these reach the container's process environment and Caddy can expand {$DOMAIN},
# {$CF_API_TOKEN} and {$EMAIL_FOR_ACME} in the Caddyfile.
#
# Interpolation values (BIND_ADDR, TAILSCALE_ADDR, APPDATA, and the tunnel token) are NOT
# here: docker compose needs them while it parses the YAML, and the contents of an env_file
# are not available for ${VAR} interpolation, so an interpolated value can live only in the
# interpolation pool (outpost.env / 00_proxy/compose.env). See docs/config-model.md "why two
# env files". The tunnel token in particular is interpolated into the tunnel's `command:` in
# compose.env; it is not an application setting and does not belong here.
#
# DOMAIN and EMAIL_FOR_ACME sit here rather than in outpost.env: that is where Caddy reads
# them (through the container's process environment), and a value is written in one place.

# Domain used for TLS. example.com is a placeholder.
DOMAIN=example.com

# Email ACME / Let's Encrypt uses for certificate generation and renewal.
EMAIL_FOR_ACME=admin@example.com

# Cloudflare API token, scope "All zones - Zone:Read, DNS:Edit".
# Create a real one at https://one.dash.cloudflare.com before starting the tunnel.
CF_API_TOKEN=changeme!

# Shared JWT secret. Create it with a strong random string such as
# https://www.grc.com/passwords.htm and use the same value on every consumer.
# Documented as a Caddy security value; wire it into a Caddyfile block when you add one.
JWT_SHARED_TOKEN=changeme!
