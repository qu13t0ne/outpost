# config.example/speedtest-tracker/app.env - application config the container reads via env_file.
#
# Handed to the container via:
#     env_file: ${OUTPOST_CONFIG_DIR}/speedtest-tracker/app.env
#
# BIND_ADDR, CONTAINER_NAME, PORT and CONFIG_PATH are interpolated by the compose file, so they
# live in the sibling compose.env, not here. The application's own settings are below.

# User id and group id the container runs as. PUID=$(id -u) PGID=$(id -g).
PUID=1000
PGID=1000

# Display name and the timezone the results are shown in.
APP_NAME=My Speedtest Tracker
FQDN=https://networkspeed.example.com
DISPLAY_TIMEZONE=America/New_York

# Encryption key. Run, and copy this including the "base64:" prefix, as APP_KEY:
#   echo -n 'base64:'; openssl rand -base64 32
APP_KEY=

# Schedule, in cron form, and how long (days) results are kept.
SPEEDTEST_SCHEDULE=*/10 * * * *
PRUNE_RESULTS_OLDER_THAN=45

# Optional SMTP delivery of results. Left blank by default; fill in only if you send results.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Speedtest Tracker
MAIL_SCHEME=smtp
