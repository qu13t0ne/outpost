# config.example/speedtest-tracker/compose.env - speedtest-tracker's interpolation values.
#
# BIND_ADDR is a shared per-host fact, so it lives once in outpost.env and is not repeated
# here. The values speedtest's compose file interpolates with ${VAR} that are its own are
# below. The application settings the container reads through `env_file:` live in the sibling
# app.env.

# Container name.
CONTAINER_NAME=speedtest-tracker

# Host port the web UI is published on, mapped to the container's 80.
PORT=8380

# Host directory that holds the app's data (results and database) on the host.
CONFIG_PATH=/srv/speedtest-tracker
