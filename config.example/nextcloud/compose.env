# config.example/nextcloud/compose.env - nextcloud's interpolation values.
#
# BIND_ADDR is a shared per-host fact, so it lives once in outpost.env and is not repeated
# here. The values nextcloud's compose file interpolates that are its own are below.

# Host port the web UI is published on, mapped to the container's 8080.
PORT=8180

# IP Apache binds to inside the AIO. The compose comment says to set it to the same address
# as BIND_ADDR, so the example matches; set it on the host.
HOST_IP=192.0.2.20

# Host directory for Nextcloud's datadir. Application data on the host, not configuration in
# the config dir; the dir is gitignored and never committed with real contents.
# Warning: do not change this after the initial installation.
DATADIR=/srv/ncdata
