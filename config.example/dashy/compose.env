# config.example/dashy/compose.env - dashy's interpolation values.
#
# BIND_ADDR is a shared per-host fact, so it lives once in outpost.env and is not repeated
# here. The values dashy's compose file interpolates that are its own are below.

# Container name.
CONTAINER_NAME=dashy

# Host port the web UI is published on, mapped to the container's 8080.
PORT=8080

# User id and group id the container runs as, so the user-data it writes is owned by you.
# Set these to your host user: PUID=$(id -u) PGID=$(id -g).
MY_UID=1000
MY_GID=1000
