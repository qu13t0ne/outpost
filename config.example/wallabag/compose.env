# config.example/wallabag/compose.env - wallabag's interpolation values.
#
# BIND_ADDR is a shared per-host fact, so it lives once in outpost.env and is not repeated
# here. wallabag has no `env_file:`, so every value its compose file interpolates is an
# interpolation value and lives here; there is no app.env for this service.

# Host port the web UI is published on, mapped to the container's 80.
PORT=8280

# Application database user. The MariaDB container is started by this same compose file.
DBUSER=wallabag

# Application database password. Generate with: openssl rand -hex 32
DBPASS=changeme!

# MariaDB root password. Generate with: openssl rand -hex 32
MYSQL_ROOT_PASSWD=changeme!

# The address mail is sent from and the displayed site title.
FROM_EMAIL=admin@example.com
DOMAINNAME=https://wallabag.example.com
SITE_TITLE=My Wallabag Instance

# Host directory wallabag reads and writes. Application data on the host, not configuration
# in the config dir; the dir is gitignored and never committed with real contents.
DATADIR=/srv/wallabag
