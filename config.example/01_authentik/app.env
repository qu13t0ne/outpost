# config.example/01_authentik/app.env - application config the containers read via env_file.
#
# Handed to the postgresql, server and worker containers via:
#     env_file: ${OUTPOST_CONFIG_DIR}/01_authentik/app.env
#
# By design a value is written once, and a value that the YAML interpolates with ${...}
# reaches the container only through the interpolation pool, not through env_file. Every
# value in 01_authentik's compose file that is interpolated (PG_DB, PG_USER, PG_PASS,
# AUTHENTIK_SECRET_KEY, AUTHENTIK_IMAGE, AUTHENTIK_TAG, COMPOSE_PORT_HTTP/HTTPS,
# CONFIG_PATH) therefore lives in the sibling compose.env, and this file carries only what
# the containers read purely through env_file - here, the timezone.

# Container timezone.
TZ=UTC
