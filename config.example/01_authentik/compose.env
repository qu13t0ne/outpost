# config.example/01_authentik/compose.env - 01_authentik's interpolation values.
#
# These are the values docker compose substitutes with ${VAR} while it parses the YAML, so
# they must live in the interpolation pool, not in app.env (an env_file's contents are not
# available for ${VAR} interpolation). The application config the containers read through
# `env_file:` lives in the sibling app.env.
#
# PG_PASS and AUTHENTIK_SECRET_KEY are secrets, and they are interpolated here by the YAML
# (${PG_PASS:?} and ${AUTHENTIK_SECRET_KEY:?} fail the compose load until they are set), so
# they live here rather than in app.env: a value that the YAML interpolates reaches a
# container only through this pool, and each value is written down in exactly one place.

# Image reference. Pinned on purpose: upgrade deliberately, then test the login flow.
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2025.8.1

# Host ports for the HTTP/HTTPS listeners, published on 127.0.0.1 only so they are reachable
# just by Caddy on this host and never from the LAN.
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443

# PostgreSQL database name and user.
PG_DB=authentik
PG_USER=authentik
# PostgreSQL password. Generate with: openssl rand -hex 32
PG_PASS=changeme!

# Application secret key. Generate with: openssl rand -hex 32 and keep it unique per
# deployment: Authentik derives session and signing material from it.
AUTHENTIK_SECRET_KEY=changeme!

# Host directory that holds Authentik media, certificates and custom templates. This is
# application data on the host, not configuration in the config dir; the example is a
# host path and is never committed with real contents (the dir is gitignored).
CONFIG_PATH=/srv/authentik
